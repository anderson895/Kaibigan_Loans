rules_version = '2';

// Kaibigan Loans security rules.
// - Admins: documents in /admins/{email}. Full access.
// - Borrowers: signed in with Google; can only see records whose email matches theirs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function setupDone() {
      return exists(/databases/$(database)/documents/meta/setup);
    }
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }
    // My Profile: a borrower who renames themselves updates the name copied onto their own loans and
    // payments, and nothing else.
    function renamesSelfOnly() {
      return signedIn()
        && resource.data.borrowerEmail == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['borrowerName'])
        && validName(request.resource.data.borrowerName);
    }

    // First sign-in after deploy claims admin (admins/{email} + meta/setup in one batch).
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !setupDone()
        && request.resource.data.owner == myEmail()
        && existsAfter(/databases/$(database)/documents/admins/$(myEmail()));
      allow update, delete: if false;
    }

    // Lender contact details (Messenger, email, phone) — public, shown on the landing page and Request Loan.
    match /meta/contact {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow get: if signedIn() && email == myEmail();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && !setupDone() && email == myEmail()
            && getAfter(/databases/$(database)/documents/meta/setup).data.owner == myEmail());
      allow update, delete: if isAdmin();
    }

    match /borrowers/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.email == myEmail());
      allow delete: if isAdmin();
      // Borrowers may change only their own name (My Profile); the rest is up to the admin.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name)
      );
      // Registered users create their own profile (doc id = their uid) — no manual "add contact" step.
      allow create: if isAdmin() || (
        signedIn()
        && id == request.auth.uid
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'payoutDetails', 'createdAt', 'termsAcceptedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
      );
    }

    match /loans/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.borrowerEmail == myEmail());
      allow update: if isAdmin() || renamesSelfOnly();
      allow delete: if isAdmin();
      // Admins create any loan; borrowers may only file a pending request for themselves.
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.borrowerEmail == myEmail()
        && get(/databases/$(database)/documents/borrowers/$(request.resource.data.borrowerId)).data.email == myEmail()
        && request.resource.data.amountPaid == 0
        && request.resource.data.interestType == 'none'
        && request.resource.data.principal is number
        && request.resource.data.principal > 0
        && request.resource.data.principal <= 100000
      );
    }

    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.borrowerEmail == myEmail());
      allow update: if isAdmin() || renamesSelfOnly();
      allow delete: if isAdmin();
      // Borrowers submit pending payments for their own active loans only; approval is admin-only.
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.borrowerEmail == myEmail()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.reviewedAt == null
        && get(/databases/$(database)/documents/loans/$(request.resource.data.loanId)).data.borrowerEmail == myEmail()
        && get(/databases/$(database)/documents/loans/$(request.resource.data.loanId)).data.status in ['ongoing', 'overdue']
      );
    }

    // Activity is also the audit log: only admins read it, and no one (not even an admin) can edit
    // or delete an entry. Borrowers may only log their own actions, of the kinds they can perform.
    match /activity/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.actorEmail == myEmail()
        && request.resource.data.type in ['loan_requested', 'payment_submitted', 'borrower_registered', 'signed_in', 'profile_updated', 'password_changed']
      );
    }
  }
}
